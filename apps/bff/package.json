{
  "name": "bff",
  "version": "0.0.1",
  "description": "BFF API: Characters from the Rick and Morty episode",
  "author": "Daniel Braz <daniel.braz@vyox.io>",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.21.0",
    "yarn": ">=1.22.22"
  },
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "prod": "node dist/main",
    "build": "nest build",
    "debug": "nest start --debug --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "lint": "oxlint --type-aware src/ tests/integration/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}