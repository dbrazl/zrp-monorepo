{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "prod": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "test:cov": {
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {},
    "format": {
      "cache": false
    }
  }
}